{
  "manifest_version": 3,
  "name": "Стоит ли брать этот дом?",
  "version": "0.2.0",
  "description": "Оценка выгодности покупки дома в King County (WA) прямо в браузере: по объявлению Zillow, Redfin или странице оценщика.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Оценить дом",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ]
}